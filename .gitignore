# ------------------------------------------------------------------
# Consent360 - Root .gitignore
# ------------------------------------------------------------------

# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
build/
dist/
.eggs/
thumbs.db

# Virtual environments
.venv/
venv/
env/
ENV/
venv.bak/

# Python test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.flake8

# Backend runtime files
*.log
logs/
server_err.log
server_out.log

# ---------- Node / Frontend ----------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo
.vite/

# Build output
dist/
build/
out/
*.local

# ---------- Environment / Secrets ----------
# Keep .env.example but ignore real .env files
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# ---------- IDE / Editor ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.suo
*.user
*.userosscache
*.sln.docstates

# ---------- Windows / macOS ----------
Desktop.ini
Thumbs.db
thumbs.db
ehthumbs.db
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------- Databases / Temp ----------
*.sqlite
*.sqlite3
*.db
*.db3
*.dbf
*.bak
*.tmp
*.temp
*.pid
temp/
tmp/
scratch/

# ---------- Project-specific ----------
# Frontend server state / dev caches
*.tsbuildinfo
# Any downloaded/scratch scratch-pads
scratch/
experiments/