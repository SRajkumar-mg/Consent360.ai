# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/consent_platform

# Security
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CONTEXT_TOKEN_EXPIRE_MINUTES=15
BCRYPT_ROUNDS=12

# Background job scheduler: consent expiry (every 15 min), renewal reminders
# and audit-chain verification (daily), context-token cleanup and KPI
# snapshots (hourly). Each run is recorded as a row in `scheduler_runs`.
# Defaults to false so `pytest` runs stay hermetic (no background jobs
# racing test transactions); set to true for any real deployment, including
# local dev if you want consents to actually expire on their own.
SCHEDULER_ENABLED=false

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy shared integration API key - kept only for callers that have not
# yet been issued a tenant-bound key (see `python seed_api_keys.py`, which
# issues one `c360_...` key per demo tenant). It authenticates but is NOT
# bound to any tenant, so a caller with it can stamp any source_app it
# likes - do not enable it in a real deployment. Only takes effect when
# ALLOW_LEGACY_INTEGRATION_KEY=true (default false; the code logs a warning
# on startup whenever it is explicitly turned on).
INTEGRATION_API_KEY=dev-demo-integration-key-2026
ALLOW_LEGACY_INTEGRATION_KEY=false

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
APP_NAME=Consent Management Platform
APP_VERSION=1.0.0

# Seed (R2-12 / gap R-07: `python seed.py` is a DEMO data loader - besides this
# admin account it also creates several other staff accounts with published,
# guessable passwords (see README.md's "Demo accounts" section) plus sample
# customers, consents and audit history. Never run it against a production
# database. There is currently no production-safe seed profile (one that
# creates only reference data - roles, permissions, an initial tenant - with
# no demo users or fixed passwords); until one exists, provision the first
# real admin by some other means. If you do run this demo seed (non-production
# only), replace the placeholder below with your own strong, unique password
# first - config.py's built-in default is the same published "Admin@1234"
# used elsewhere in the docs, and an empty value here is read as a literal
# empty password, not "use the default", so never leave this blank either.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUNNING_SEED
