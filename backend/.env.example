# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/consent_platform

# Security
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CONTEXT_TOKEN_EXPIRE_MINUTES=15
BCRYPT_ROUNDS=12

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Field-level AES-256-GCM encryption (base64-encoded 32-byte key)
FIELD_ENCRYPTION_KEY=mxJ5Wp4V67jT_-8POdv1zyqfUu0lTRmi7UfJo04zHig=

# Separate HMAC search key for encrypted equality lookups (base64-encoded 32-byte key)
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
HMAC_SEARCH_KEY=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
APP_NAME=Consent Management Platform
APP_VERSION=1.0.0

# Seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@1234